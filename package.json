{
  "name": "interview-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for technical interviewers, with an MCP server for AI clients.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build && node src/web/server.ts",
    "dev": "concurrently -k -n server,client \"node --watch src/web/server.ts\" \"vite\"",
    "mcp": "node src/mcp/server.ts",
    "demo": "node src/web/load-demo.ts",
    "evaluate": "node src/evaluation/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitejs/plugin-react": "^6.3.0",
    "fflate": "0.8",
    "hono": "^4.13.17",
    "pdfjs-dist": "6.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
